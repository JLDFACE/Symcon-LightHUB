{
  "elements": [
    {
      "type": "ValidationTextBox",
      "name": "Host",
      "caption": "Host/IP (LightHUB; lokal auf dem Catan: 127.0.0.1)"
    },
    {
      "type": "NumberSpinner",
      "name": "Port",
      "caption": "Port",
      "minimum": 1,
      "maximum": 65535
    },
    {
      "type": "ValidationTextBox",
      "name": "Username",
      "caption": "Benutzer (LightHUB-Konto, Rolle Automation; leer = ohne Anmeldung)"
    },
    {
      "type": "PasswordTextBox",
      "name": "Password",
      "caption": "Passwort"
    },
    {
      "type": "NumberSpinner",
      "name": "Poll",
      "caption": "Abfrage-Intervall (s)",
      "minimum": 1,
      "maximum": 60
    }
  ],
  "actions": [
    {
      "type": "Button",
      "caption": "Jetzt abfragen",
      "onClick": "ANP_Poll($id);"
    },
    {
      "type": "Label",
      "caption": "Danach je Player eine 'LightHUB Player'-Instanz anlegen und dort die Player-ID setzen."
    }
  ],
  "status": [
    { "code": 102, "icon": "active", "caption": "Verbunden" },
    { "code": 104, "icon": "inactive", "caption": "Host/Port nicht konfiguriert" },
    { "code": 201, "icon": "error", "caption": "Tool nicht erreichbar" },
    { "code": 202, "icon": "error", "caption": "Anmeldung abgelehnt - Benutzer/Passwort pruefen" }
  ]
}
