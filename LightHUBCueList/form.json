  "actions": [
    { "type": "Button", "caption": "Werte jetzt aktualisieren", "onClick": "LHC_Refresh($id);" }
  ],
  "status": [
    { "code": 102, "icon": "active", "caption": "OK" },
    { "code": 104, "icon": "inactive", "caption": "Kein Controller / Cue-Liste unbekannt" }
